{
  "name": "mindoodb-app-todomanager",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "MindooDB To Do Manager app for Haven",
  "license": "ISC",
  "author": "Mindoo GmbH",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "vite --port 4202",
    "dev:local": "LOCAL_MINDOODB=1 vite --port 4202",
    "build": "vue-tsc --noEmit && vite build",
    "build:local": "LOCAL_MINDOODB=1 vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@primeuix/styled": "^0.7.4",
    "@primeuix/themes": "^2.0.3",
    "flexsearch": "^0.8.212",
    "mindoodb-app-sdk": "0.0.20",
    "mindoodb-view-language": "0.0.13",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.31",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.83.0"
  }
}
